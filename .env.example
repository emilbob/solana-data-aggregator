# Copy to `.env` and fill in. Docker Compose reads `.env` automatically for the
# ${VAR} values in docker-compose.yml, and `cargo run` reads it via dotenv.

# Required — Solana RPC endpoint. A dedicated provider (e.g. Helius) avoids the
# public endpoints' rate limits.
SOLANA_RPC_URL=https://api.testnet.solana.com

# Required — account(s) to monitor. Use SOLANA_PUBLIC_KEYS (comma-separated)
# and/or the single SOLANA_PUBLIC_KEY; they are merged and de-duplicated.
SOLANA_PUBLIC_KEYS=YourPublicKeyHere
# SOLANA_PUBLIC_KEY=YourPublicKeyHere

# Optional tuning.
FETCH_LIMIT=5
POLL_TIMEOUT_SECS=10
# WEBSOCKET=true            # real-time ingestion (SOLANA_WS_URL overrides the WS endpoint)
# SERVER_ADDR=127.0.0.1:3030  # cargo run only; the container binds 0.0.0.0:3030
# DATABASE_URL=postgres://solana:solana@localhost:5432/solana_aggregator  # cargo run vs compose Postgres
